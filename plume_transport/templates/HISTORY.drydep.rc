###############################################################################
### Stage-1 dry-deposition A/B diagnostics at the 10-minute heartbeat.       ###
###############################################################################

EXPID: ./OutputDir/GEOSChem

COLLECTIONS: 'Restart',
             'SpeciesConc',
             'Budget',
             'DryDep',
::

  Restart.filename:      './Restarts/GEOSChem.Restart.%y4%m2%d2_%h2%n2z.nc4',
  Restart.frequency:     'End',
  Restart.duration:      'End',
  Restart.mode:          'instantaneous'
  Restart.fields:        'SpeciesRst_?ALL?               ',
                         'Met_DELPDRY                    ',
                         'Met_BXHEIGHT                   ',
                         'Met_TropLev                    ',
::

  SpeciesConc.template:  '%y4%m2%d2_%h2%n2z.nc4',
  SpeciesConc.frequency: 00000000 002000
  SpeciesConc.duration:  00000000 002000
  SpeciesConc.mode:      'time-averaged'
  SpeciesConc.fields:    'SpeciesConcVV_?ALL?           ',
::

  Budget.template:       '%y4%m2%d2_%h2%n2z.nc4',
  # Heartbeat-level full-column budget used for quantitative reconciliation.
  Budget.frequency:      00000000 001000
  Budget.duration:       00000000 001000
  Budget.mode:           'time-averaged'
  Budget.fields:         'BudgetEmisDryDepFull_?ADV?    ',
                         'BudgetTransportFull_?ADV?     ',
::

  # Retained as a qualitative process diagnostic; quantitative loss closure
  # uses BudgetEmisDryDepFull because DryDepMix is not the same applied loss.
  DryDep.template:       '%y4%m2%d2_%h2%n2z.nc4',
  DryDep.frequency:      00000000 001000
  DryDep.duration:       00000000 001000
  DryDep.mode:           'time-averaged'
  DryDep.fields:         'DryDepMix_?DRY?               ',
                         'DryDepVel_?DRY?               ',
::
